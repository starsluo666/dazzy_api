DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=dazzy_test
POSTGRES_USER=dazzy
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60
DJANGO_DB_ENGINE=django.contrib.gis.db.backends.postgis
# 仅供本地联调；生产环境不得配置。
DAZZY_DEMO_USER_PUBLIC_ID=
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
SMS_PHONE_DAILY_LIMIT=10
AUTH_SMS_SEND_RATE=10/min
AUTH_SMS_SEND_IP_DAILY_RATE=50/day
AUTH_REGISTER_RATE=5/min
AUTH_LOGIN_RATE=30/min
ADMIN_AUTH_REFRESH_RATE=60/min
AUTH_PASSWORD_RESET_RATE=10/min
AUTH_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=30
AUTH_LOCK_SECONDS=900
# 管理端 Refresh Token Cookie；生产环境仅在确需跨子域共享时设置 Domain。
ADMIN_REFRESH_COOKIE_NAME=dazzy_admin_refresh
ADMIN_REFRESH_COOKIE_DOMAIN=
# API 前存在几层可信反向代理就填写几；直连或本地开发保持 0。
DRF_NUM_PROXIES=0
PAYMENT_REFUND_PROCESSING_TIMEOUT_SECONDS=300

# 汇付聚合支付。真实参数只通过部署环境或密钥管理服务注入，不要提交到仓库。
# 在商户、微信渠道、RSA 密钥、异步通知均完成联调前必须保持 false。
HUIFU_PAYMENT_ENABLED=false
HUIFU_ENV=mertest
HUIFU_SYS_ID=
HUIFU_PRODUCT_ID=
HUIFU_MERCHANT_ID=
HUIFU_RSA_PRIVATE_KEY=
HUIFU_RSA_PUBLIC_KEY=
HUIFU_SKILL_SOURCE=hfps/1.3.5
HUIFU_NOTIFY_URL=
# 1=外扣，2=内扣；当前平台承担通道费方案使用外扣，最终以汇付开通配置为准。
HUIFU_FEE_FLAG=1
HUIFU_CONNECT_TIMEOUT_SECONDS=15

# 微信服务号 H5：AppSecret 仅允许在后端部署环境注入。
WECHAT_OFFICIAL_ACCOUNT_APP_ID=
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=
# 示例：https://api.example.com/api/v1/payments/wechat/oauth/callback/
WECHAT_OFFICIAL_ACCOUNT_OAUTH_CALLBACK_URL=
# 示例：https://m.example.com/#/pages/booking/payment
WECHAT_OFFICIAL_ACCOUNT_H5_PAYMENT_URL=
# Android/iOS 原生 App 聚合支付后续启用；当前 H5 阶段可留空。
WECHAT_MOBILE_APP_ID=
# 微信小程序登录。AppSecret 只能配置在 API 服务端，禁止写入小程序工程。
WECHAT_CUSTOMER_MINI_PROGRAM_APP_ID=
WECHAT_CUSTOMER_MINI_PROGRAM_APP_SECRET=
WECHAT_PROVIDER_MINI_PROGRAM_APP_ID=
WECHAT_PROVIDER_MINI_PROGRAM_APP_SECRET=
WECHAT_MINI_PROGRAM_TIMEOUT_SECONDS=10
AUTH_WECHAT_LOGIN_RATE=20/min
WECHAT_OAUTH_STATE_MAX_AGE_SECONDS=600
WECHAT_OAUTH_TIMEOUT_SECONDS=10
PROVIDER_ORDER_PAYMENT_CREATE_RATE=10/min
PROVIDER_ORDER_PAYMENT_STATUS_RATE=30/min

REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CACHE_DB=0
REDIS_CELERY_DB=1
REDIS_CHANNELS_DB=2

COS_REGION=ap-beijing
COS_BUCKET=
COS_BASE_URL=
COS_PUBLIC_PREFIX=dazzy-test/public/
COS_PRIVATE_PREFIX=dazzy-test/private/
COS_SIGNED_PUBLIC_URL_TTL=3600
COS_SIGNED_PRIVATE_URL_TTL=300

TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=

# 腾讯位置服务 WebService API，仅后端使用，禁止写入前端环境变量。
TENCENT_MAP_WEB_SERVICE_KEY=
TENCENT_MAP_WEB_SERVICE_SK=
TENCENT_MAP_DEFAULT_REGION=邯郸市
TENCENT_MAP_TIMEOUT_SECONDS=5
MAP_PROXY_BURST_RATE=30/min
MAP_PROXY_DAILY_RATE=500/day
