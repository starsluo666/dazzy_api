DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=dazzy_test
POSTGRES_USER=dazzy
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60
DJANGO_DB_ENGINE=django.contrib.gis.db.backends.postgis
# 仅供本地联调；生产环境不得配置。
DAZZY_DEMO_USER_PUBLIC_ID=
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
SMS_PHONE_DAILY_LIMIT=10
AUTH_SMS_SEND_RATE=10/min
AUTH_SMS_SEND_IP_DAILY_RATE=50/day
AUTH_REGISTER_RATE=5/min
# 每年按官方公告维护完整工作日历；2026 年内置，跨年缺失时拒绝注销申请。
ACCOUNT_CLOSURE_CALENDAR_JSON={}
AUTH_LOGIN_RATE=30/min
ADMIN_AUTH_REFRESH_RATE=60/min
AUTH_PASSWORD_RESET_RATE=10/min
AUTH_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=30
AUTH_LOCK_SECONDS=900
# 管理端 Refresh Token Cookie；生产环境仅在确需跨子域共享时设置 Domain。
ADMIN_REFRESH_COOKIE_NAME=dazzy_admin_refresh
ADMIN_REFRESH_COOKIE_DOMAIN=
# API 前存在几层可信反向代理就填写几；直连或本地开发保持 0。
DRF_NUM_PROXIES=0
PAYMENT_REFUND_PROCESSING_TIMEOUT_SECONDS=300

# 汇付聚合支付。真实参数只通过部署环境或密钥管理服务注入，不要提交到仓库。
# 在商户、微信渠道、RSA 密钥、异步通知均完成联调前必须保持 false。
HUIFU_PAYMENT_ENABLED=false
HUIFU_ENV=mertest
HUIFU_SYS_ID=
HUIFU_PRODUCT_ID=
HUIFU_MERCHANT_ID=
HUIFU_RSA_PRIVATE_KEY=
HUIFU_RSA_PUBLIC_KEY=
HUIFU_SKILL_SOURCE=hfps/1.3.5
HUIFU_NOTIFY_URL=
# 1=外扣（平台另付），2=内扣（从平台分账份额扣除实际支付手续费，达人份额不变）。
# 按汇付实际开通方式填写；不是费率，不影响独立的提现手续费配置。
HUIFU_FEE_FLAG=1
HUIFU_CONNECT_TIMEOUT_SECONDS=15
# Provider delayed-distribution pilot: default closed; jobs have a separate switch below.
HUIFU_PROVIDER_DELAYED_PAYMENT_ENABLED=false
HUIFU_PROVIDER_DISTRIBUTION_ENABLED=false
HUIFU_PROVIDER_DISTRIBUTION_IDS=
HUIFU_PROVIDER_PLATFORM_FEE_POLICY_CONFIRMED=false
HUIFU_PROVIDER_DISTRIBUTION_MAX_CENTS=0

# 微信服务号 H5：AppSecret 仅允许在后端部署环境注入。
WECHAT_OFFICIAL_ACCOUNT_APP_ID=
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=
# 示例：https://api.example.com/api/v1/payments/wechat/oauth/callback/
WECHAT_OFFICIAL_ACCOUNT_OAUTH_CALLBACK_URL=
# 示例：https://m.example.com/#/pages/booking/payment
WECHAT_OFFICIAL_ACCOUNT_H5_PAYMENT_URL=
# Android/iOS 原生 App 聚合支付后续启用；当前 H5 阶段可留空。
WECHAT_MOBILE_APP_ID=
WECHAT_MOBILE_APP_SECRET=
# 示例：https://api.example.com/api/v1/auth/login/wechat/h5/callback/
WECHAT_H5_LOGIN_CALLBACK_URL=
# 示例：https://app.example.com/#/pages/auth/login
WECHAT_H5_LOGIN_RETURN_URL=
WECHAT_LOGIN_TICKET_TTL_SECONDS=300
# 仅在服务号和移动应用绑定同一微信开放平台账号后启用。
WECHAT_CROSS_CHANNEL_UNIONID_ENABLED=false
# 微信小程序登录。AppSecret 只能配置在 API 服务端，禁止写入小程序工程。
WECHAT_CUSTOMER_MINI_PROGRAM_APP_ID=
WECHAT_CUSTOMER_MINI_PROGRAM_APP_SECRET=
WECHAT_PROVIDER_MINI_PROGRAM_APP_ID=
WECHAT_PROVIDER_MINI_PROGRAM_APP_SECRET=
WECHAT_MINI_PROGRAM_TIMEOUT_SECONDS=10
AUTH_WECHAT_LOGIN_RATE=20/min
WECHAT_OAUTH_STATE_MAX_AGE_SECONDS=600
WECHAT_OAUTH_TIMEOUT_SECONDS=10
PROVIDER_ORDER_PAYMENT_CREATE_RATE=10/min
PROVIDER_ORDER_PAYMENT_STATUS_RATE=30/min

REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CACHE_DB=0
REDIS_CELERY_DB=1
REDIS_CHANNELS_DB=2

COS_REGION=ap-beijing
COS_BUCKET=
COS_BASE_URL=
COS_PUBLIC_PREFIX=dazzy-test/public/
COS_PRIVATE_PREFIX=dazzy-test/private/
COS_SIGNED_PUBLIC_URL_TTL=3600
COS_SIGNED_PRIVATE_URL_TTL=300
# 身份证水印中文字体：Docker 已安装文泉驿；非 Docker 部署可填写本机 CJK 字体路径。
PROVIDER_IDENTITY_WATERMARK_FONT_PATH=

TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=

# 腾讯位置服务 WebService API，仅后端使用，禁止写入前端环境变量。
TENCENT_MAP_WEB_SERVICE_KEY=
TENCENT_MAP_WEB_SERVICE_SK=
TENCENT_MAP_DEFAULT_REGION=邯郸市
TENCENT_MAP_TIMEOUT_SECONDS=5
MAP_PROXY_BURST_RATE=30/min
MAP_PROXY_DAILY_RATE=500/day

# 收款资料登记（不是汇付开户/分账开关），默认关闭。启用前设置独立 AES-256 密钥。
PROVIDER_RECEIVING_ACCOUNT_COLLECTION_ENABLED=false
PROVIDER_RECEIVING_ACCOUNT_ENCRYPTION_KEY=

# 达人个人开户/本人银行卡手动提现。仅配置不触发开户，需达人单独授权提交。
# 共用服务端 HUIFU_SYS_ID/PRODUCT_ID/RSA 密钥，仅正式环境；不要填写沙箱测试凭据。
HUIFU_USER_ONBOARDING_ENABLED=false
HUIFU_USER_UPPER_ID=
HUIFU_USER_NOTIFY_URL=
HUIFU_USER_SKILL_SOURCE=hfps/1.3.5;hfms/1.0.4
# 旧自动结算配置仅保留用于历史排查，新开户不会读取、不会回退到此配置。
HUIFU_USER_SETTLEMENT_CONFIG=
# JSON 对象，真实费率由平台与汇付核实后填写；不能照抄文档示例费率。
# cash_type=T1/D1；fix_amt/fee_rate 至少一项；out_fee_flag=1；
# out_fee_huifu_id=平台 HUIFU_MERCHANT_ID；out_fee_acct_type=经核实的01/02/05。
# D1 可另配 weekday_fix_amt/weekday_fee_rate。旧账户需渠道实际关闭自动结算。
HUIFU_USER_CASH_CONFIG=
# 默认关闭；还须分账白名单、平台费用规则确认、已核验手动取现及足额渠道余额。
HUIFU_PROVIDER_WITHDRAWAL_ENABLED=false
HUIFU_PROVIDER_WITHDRAWAL_MAX_CENTS=0
# Celery Beat 每分钟调度；仅开启此开关才处理符合条件的分账及查询提现。
HUIFU_PROVIDER_INCOME_JOBS_ENABLED=false
